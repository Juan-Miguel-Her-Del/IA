{
  "schema_version": 1,
  "protocol": "vision-runtime-val-v1",
  "description": "Criterios iniciales de comparación offline; son metas de selección, no precisión prometida.",
  "constraints": {
    "own_architectures": true,
    "foreign_pretrained_weights": false,
    "test_for_selection": false,
    "automatic_runtime_replacement": false
  },
  "guards": {
    "original_macro_f1_max_drop": 0.01,
    "original_class_recall_max_drop": 0.05,
    "scene_macro_f1_max_drop": 0.01,
    "source_map95_max_drop": 0.01,
    "detector_precision_max_drop": 0.02,
    "joint_recall_max_drop": 0.0,
    "primary_joint_recall_max_drop": 0.0,
    "latency_p95_max_ratio": 1.25
  },
  "minimum_gains": {
    "material": {"scene_accuracy": 0.05, "scene_macro_f1_present": 0.03},
    "detector": {"map50": 0.02, "recall": 0.03},
    "pipeline": {"joint_recall": 0.03, "primary_joint_recall": 0.01}
  },
  "field_collection": {
    "pilot_independent_objects_per_class": 30,
    "expanded_independent_objects_per_class": 100,
    "minimum_capture_sessions": 5,
    "minimum_empty_scenes": 60,
    "minimum_unsupported_objects": 60,
    "splits": ["train", "calibration", "val", "test"],
    "group_by": ["physical_object_id", "capture_session_id"],
    "note": "Fotos del mismo objeto o sesión deben permanecer en la misma partición. Cuotas de colección, no tamaño suficiente para certificar precisión."
  }
}
